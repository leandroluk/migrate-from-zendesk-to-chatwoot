# ==============================================================================
# CONFIGURAÇÃO DE MIGRAÇÃO: ZENDESK -> CHATWOOT
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ZENDESK (Origem)
# ------------------------------------------------------------------------------
# URL base do painel Zendesk (ex: https://sua-empresa.zendesk.com)
ZENDESK_BASE_URL=https://sua-empresa.zendesk.com

# E-mail do usuário administrador/agente com acesso à API do Zendesk
ZENDESK_EMAIL=admin@sua-empresa.com.br

# Token de API do Zendesk (gerado em: Admin Center > Aplicativos e integrações > APIs do Zendesk)
ZENDESK_API_TOKEN=seu_token_api_zendesk

# ------------------------------------------------------------------------------
# 2. CHATWOOT (Destino)
# ------------------------------------------------------------------------------
# URL base da sua instalação do Chatwoot (para Cloud: https://app.chatwoot.com, ou URL auto-hospedada)
CHATWOOT_BASE_URL=https://app.chatwoot.com

# Token de acesso da API do Chatwoot (gerado em: Configurações do Perfil > Token de acesso da API)
CHATWOOT_API_TOKEN=seu_token_de_acesso_chatwoot

# ID numérico da conta do Chatwoot (visível na URL do navegador, ex: /app/accounts/186408/...)
CHATWOOT_ACCOUNT_ID=186408

# ID da caixa de entrada de destino no Chatwoot (visível em Configurações > Caixas de Entrada)
# IMPORTANTE: A caixa DEVE ser do tipo "Canal de API" (Channel::Api) para permitir postagem
# de mensagens do cliente com tipo "incoming" via API.
CHATWOOT_INBOX_ID=148532

# ------------------------------------------------------------------------------
# 3. CONTROLE DE ESCOPO DA MIGRAÇÃO
# ------------------------------------------------------------------------------
# Define quais chamados serão migrados:
#   - ID único:              496642
#   - Lista de IDs:          496642,496643,496644
#   - Todos os chamados:     * (processa em lote iterativo buscando tickets sem a tag 'chatwoot')
MIGRATION_TICKET_ID_LIST=496642

# ------------------------------------------------------------------------------
# 4. CONFIGURAÇÕES ADICIONAIS E POLÍTICAS DE EXECUÇÃO
# ------------------------------------------------------------------------------
# Idioma para os cabeçalhos históricos de mensagens e tradução de papéis/status ('pt-BR' ou 'en-US')
# Padrão: pt-BR
MIGRATION_LOCALE=pt-BR

# Tamanho da página para busca em lote no Zendesk (Padrão: 25)
MIGRATION_BATCH_SIZE=25

# Modo de simulação (Dry Run):
#   - true:  Executa todas as validações, simula as extrações e não cria nada no Chatwoot/Zendesk.
#   - false: Executa a migração real em produção.
# Padrão: false
MIGRATION_DRY_RUN=false

# Política de Anti-Duplicação e Atualização Forçada (Force Update):
#   - false: PESQUISA no Chatwoot se o chamado já foi migrado (pelo zendesk_link / zendesk_ticket_id).
#            Se já existir, IGNORA a criação para evitar conversas duplicadas.
#   - true:  Força a recriação/atualização do chamado mesmo se ele já existir no Chatwoot
#            (útil quando você quer reenviar para incluir anexos/imagens que faltavam).
# Padrão: false
MIGRATION_FORCE_UPDATE=false
