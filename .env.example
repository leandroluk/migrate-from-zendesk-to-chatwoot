# Zendesk Configuration
ZENDESK_BASE_URL=https://your_subdomain.zendesk.com
ZENDESK_EMAIL=admin@example.com
ZENDESK_API_TOKEN=your_api_token

# Chatwoot Configuration
CHATWOOT_BASE_URL=https://app.chatwoot.com
CHATWOOT_API_TOKEN=your_api_access_token
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1

# Migration Configuration
# Specific ticket ID or comma-delimited list (e.g. 101 or 101,102,103), or '*' to migrate all tickets
MIGRATION_TICKET_ID_LIST=101,102,103

# Optional Settings
# Dictionary / Locale used for generated notes, messages and role translations ('pt-BR' or 'en-US')
MIGRATION_LOCALE=pt-BR
MIGRATION_BATCH_SIZE=25
MIGRATION_DRY_RUN=false
